# ==============================================
# ECL Academy - Variables de entorno
# Copia este archivo a .env.local y completa los valores
# ==============================================

# URL base del sitio (usada en callbacks de Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Autenticación -----
# Clave para firmar los JWT de sesión. Genera una con:
#   openssl rand -base64 32
AUTH_SECRET=

# ----- Stripe -----
# Obtén tus llaves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
# Secreto del webhook (stripe listen / dashboard de webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ----- evolCampus (EvolMind) - LMS / matrículas -----
# Autenticación por JWT (POST /v1/token con clientid + key).
# Obtén clientid y key en el panel de tu cuenta evolCampus.
EVOLMIND_API_URL=https://api.evolcampus.com/api
EVOLMIND_CLIENT_ID=
EVOLMIND_API_KEY=

# ----- Email (acceso por enlace mágico / notificaciones) -----
# Con Resend (https://resend.com). Sin esto, los emails se registran en consola.
RESEND_API_KEY=
EMAIL_FROM="ECL Academy <no-reply@eclacademy.io>"

# ----- Admin -----
# Token para endpoints administrativos (reintento de sync, test de Evolmind).
# Genera uno con: openssl rand -hex 24
ADMIN_TOKEN=

# ----- evolCampus panel (scraping: crear/editar/borrar asignaturas) -----
# Login por autologin del admin (no requiere guardar contraseña del panel).
EVOLCAMPUS_ADMIN_URL=https://gestionv1-cXXXXXX.evolcampus.com
EVOLCAMPUS_LOGIN_MODE=autologin
EVOLCAMPUS_ADMIN_EMAIL=admin@tudominio.com

# ==============================================
# MARCA (parametrizable) — para clonar el proyecto a otra marca.
# Todos son OPCIONALES: si no se definen, se usan los valores por defecto
# (ECL Academy) en src/lib/brand.ts. Deben llevar prefijo NEXT_PUBLIC_.
# ==============================================
NEXT_PUBLIC_BRAND_NAME="ECL Academy"
NEXT_PUBLIC_BRAND_NAME_PREFIX="ECL"
NEXT_PUBLIC_BRAND_NAME_HIGHLIGHT="Academy"
NEXT_PUBLIC_BRAND_COMPANY="Ecommerce Logistics LLC"
NEXT_PUBLIC_BRAND_TAGLINE="Tu Puerta al Mercado de EE.UU."
NEXT_PUBLIC_BRAND_DESCRIPTION="Talleres especializados para sellers de Amazon en Latinoamérica."
NEXT_PUBLIC_BRAND_SHORT_DESCRIPTION="Educación especializada para sellers de Amazon en Latinoamérica."
NEXT_PUBLIC_BRAND_CITY="Miami, FL, USA"
NEXT_PUBLIC_BRAND_DOMAIN="eclacademy.io"
NEXT_PUBLIC_BRAND_YEAR="2026"
# Logos en /public (reemplaza los archivos o cambia la ruta)
NEXT_PUBLIC_BRAND_LOGO="/logoecl.png"
NEXT_PUBLIC_BRAND_PARTNER_LOGO="/spn-logo.jpeg"
# Paleta (informativa; el CSS usa :root en globals.css)
NEXT_PUBLIC_BRAND_PRIMARY="#ff9900"
NEXT_PUBLIC_BRAND_DARK="#232f3e"
NEXT_PUBLIC_BRAND_DARKER="#131921"
# Redes sociales (footer)
NEXT_PUBLIC_BRAND_FACEBOOK="#"
NEXT_PUBLIC_BRAND_INSTAGRAM="#"
NEXT_PUBLIC_BRAND_LINKEDIN="#"
NEXT_PUBLIC_BRAND_YOUTUBE="#"
